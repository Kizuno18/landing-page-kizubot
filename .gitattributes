# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.c text
*.h text
*.cpp text
*.hpp text
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.md text
*.py text
*.lua text
*.sh text eol=lf
*.bash text eol=lf
*.yml text
*.yaml text
*.xml text
*.html text
*.css text
*.scss text
*.sql text
*.dockerfile text
Dockerfile text

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.dat binary
*.klua binary
*.klua32 binary
